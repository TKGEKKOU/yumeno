# YUMENO 本地基础设施配置。
# 本文件可复制为 .env；.env 已被 Git 忽略，禁止提交密码或 Provider Key。
# LLM、Embedding 与联网搜索配置在 Web 工作台的“设置”页保存到
# data/local_settings.json，不在本文件配置。

# ===== Milvus 向量数据库 =====
# 默认使用嵌入式 milvus-lite，不需要 Docker Desktop。
# 可选远程 Milvus：MILVUS_DB_URI=http://127.0.0.1:19530
MILVUS_DB_URI=./data/milvus_local.db
# 本地文件模式不使用账号；远程模式按服务端鉴权填写。
MILVUS_USER=
MILVUS_PASSWORD=
# Collection 是向量索引的逻辑名称。改变 Embedding 维度时应使用新的名称重建索引。
COLLECTION_NAME=yumeno_knowledge_v1

# ===== SQLite 应用数据库 =====
# 角色、对话、记忆与会话状态存储于本地单文件；data/ 目录已被 Git 忽略。
DB_PATH=data/yumeno.db

# ===== RVC 音频生产 =====
# RVC 默认必须使用独立 GPU 运行时；只有明确改为 cpu 才使用 CPU。
YUMENO_RVC_DEVICE=cuda
# 可选：自建 Hugging Face 镜像/代理，不填则按内置源顺序尝试。
# YUMENO_RVC_HF_ENDPOINT=

# ===== FastAPI 服务 =====
# 默认仅绑定本机回环地址，避免未配置认证时暴露资料和本地设置。
APP_HOST=127.0.0.1
APP_PORT=17000

# ===== RAG 流程控制 =====
# default 使用 Adaptive/Corrective RAG；adaptive 为兼容别名；不支持绕过质量链的 simple。
RAG_PIPELINE=default
# 本地证据不足时最多改写查询次数，以及答案质量门最多生成重试次数。
MAX_REWRITE_COUNT=1
MAX_GENERATION_RETRY=1
# Reranker 置信度低于该阈值时，答案会进入质量检查与纠错路径。
DEFAULT_CONFIDENCE_THRESHOLD=0.75
# 单文件上传大小上限（MB）。
MAX_UPLOAD_MB=50
